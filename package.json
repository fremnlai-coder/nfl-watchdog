{
  "name": "nfl-watchdog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spoilervrije NFL kijkgids met DAZN-formaatadvies en weektijdsbudget",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "node src/ingest.js",
    "week": "node src/cli.js",
    "stage": "node scripts/copy-data.js",
    "dev": "npm run stage && vite",
